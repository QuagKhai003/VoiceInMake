# VoiceInMake — Server Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.

# -----------------------------------------------
# REQUIRED
# -----------------------------------------------

# OpenAI API key — used for:
#   - Whisper (whisper-1): speech-to-text transcription via POST /api/voice
#   - GPT-4o: invoice entity extraction from transcript
#   - GPT-4o-mini: assistant planning via POST /api/assistant/plan
OPENAI_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------
# OPTIONAL — defaults shown
# -----------------------------------------------

# Express server port (default: 3000)
PORT=3000

# MongoDB connection string. If MongoDB is unavailable, an in-memory
# fallback server starts automatically — no manual MongoDB install required.
MONGODB_URI=mongodb://localhost:27017/voiceinmake

# Override the model used for the assistant planner (default: gpt-4o-mini)
# OPENAI_PLANNER_MODEL=gpt-4o-mini
